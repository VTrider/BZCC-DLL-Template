{
 "version": 10,
 "configurePresets": [
   {
     "name": "base",
     "displayName": "base",
     "hidden": true,
     "architecture": {
       "value": "x86",
       "strategy": "external"
     },
     "generator": "Ninja",
     "binaryDir": "${sourceDir}/build/${presetName}",
     "cacheVariables": {
       "PRESET_DIR": "${sourceDir}/build/${presetName}",
       "CMAKE_EXPORT_COMPILE_COMMANDS": true
     }
   },
   {
     "name": "x86-debug",
     "inherits": "base",
     "cacheVariables": {
         "CMAKE_BUILD_TYPE": "Debug"
     }
   },
   {
     "name": "x86-release",
     "inherits": "base",
     "cacheVariables": {
       "CMAKE_BUILD_TYPE": "Release"
     }
   }
 ],
 "buildPresets": [
   {
     "name": "x86-debug",
     "configurePreset": "x86-debug"
   },
   {
     "name": "x86-release",
     "configurePreset": "x86-release"
   }
 ]
}
